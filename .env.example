# Copy this file to .env and fill in values. Never commit .env.

# Optional: only needed if/when we integrate api-football (not used yet)
API_FOOTBALL_KEY=

# Local SQLite database used for processed/queryable data
DB_PATH=./data/football.db

# Where raw scraper/API output is cached before transformation
CACHE_DIR=./data/raw

# Minimum delay (seconds) between requests to any single external source
SCRAPE_DELAY_SECONDS=3
